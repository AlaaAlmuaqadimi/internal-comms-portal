<%- include('../partials/layout-start') %>
<div class="max-w-3xl mx-auto">
  <div class="mb-7 border-r-4 border-[#c4a56a] pr-4">
    <h1 class="font-extrabold leading-tight text-[#14283f] text-[32px]">مكالمة صوتية</h1>
    <p class="mt-1 text-[#526579] text-[16px]">التواصل مع الزملاء ضمن بيئة العمل الداخلية</p>
  </div>

  <section id="call-view" aria-label="المكالمة الحالية" class="reveal">
    <article class="surface rounded-[24px] border border-[#e3e9ef] overflow-hidden bg-white">
      <div class="h-2 bg-[#1769a3]" aria-hidden="true"></div>
      <div class="p-6 sm:p-10">
        <div class="flex flex-col sm:flex-row items-center sm:items-start text-center sm:text-right gap-5">
          <%- include('../partials/avatar', { person: caller, cls: 'w-24 h-24 sm:w-28 sm:h-28 rounded-2xl border-4 border-white shadow-md text-3xl' }) %>
          <div class="min-w-0 flex-1 pt-1">
            <p class="text-[#64748b] text-[14px]">الموظف المتصل</p>
            <h2 class="font-bold leading-snug mt-1 text-[#14283f] text-[23px]"><%= caller.name %></h2>
            <p class="mt-1 font-semibold text-[#1769a3] text-[16px]"><%= caller.title %></p>
            <p class="mt-1 text-[#526579] text-[16px]"><%= caller.department %></p>
          </div>
          <div class="flex items-center gap-2 rounded-full bg-[#eaf6f1] px-4 py-2 shrink-0">
            <span class="status-dot" aria-hidden="true"></span>
            <span class="font-bold text-[#18735e] text-[14px]">متصل الآن</span>
          </div>
        </div>
        <div class="mt-8 pt-7 border-t border-[#e3e9ef] grid sm:grid-cols-2 gap-5 items-center">
          <div>
            <p class="text-[#64748b] text-[14px]">مدة المكالمة</p>
            <p id="timer" class="font-bold text-[34px] tracking-wider tabular-nums text-[#14283f] leading-tight" dir="ltr" aria-live="off">00:00</p>
          </div>
          <div class="flex items-center gap-3 sm:justify-end text-[#1769a3]">
            <i data-lucide="shield" class="w-5 h-5 shrink-0" aria-hidden="true"></i>
            <span class="font-semibold text-[#1769a3] text-[14px]">مكالمة داخلية آمنة</span>
          </div>
        </div>
      </div>
    </article>

    <section class="surface mt-5 rounded-[24px] border border-[#e3e9ef] p-5 sm:p-7 bg-white" aria-label="التحكم بالمكالمة">
      <h2 class="font-bold mb-5 text-[#14283f] text-[24px]">التحكم بالمكالمة</h2>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        <button id="mute" type="button" aria-pressed="false" class="action rounded-xl border border-[#dbe4ec] bg-white p-4 flex flex-col items-center gap-2 text-[#14283f]">
          <i data-lucide="mic-off" class="w-6 h-6" aria-hidden="true"></i>
          <span id="mute-label" class="font-bold text-[14px]">كتم الصوت</span>
          <span id="unmute-label" class="font-bold text-[#1769a3] text-[14px]" hidden>إلغاء كتم الصوت</span>
        </button>
        <button id="speaker" type="button" aria-pressed="false" class="action rounded-xl border border-[#dbe4ec] bg-white p-4 flex flex-col items-center gap-2 text-[#14283f]">
          <i data-lucide="volume-2" class="w-6 h-6" aria-hidden="true"></i>
          <span id="speaker-label" class="font-bold text-[14px]">مكبر الصوت</span>
          <span id="speaker-on-label" class="font-bold text-[#1769a3] text-[14px]" hidden>إيقاف مكبر الصوت</span>
        </button>
        <button id="keypad-toggle" type="button" aria-expanded="false" aria-controls="keypad" class="action rounded-xl border border-[#dbe4ec] bg-white p-4 flex flex-col items-center gap-2 text-[#14283f]">
          <i data-lucide="grid-3x3" class="w-6 h-6" aria-hidden="true"></i>
          <span class="font-bold text-[14px]">لوحة الأرقام</span>
        </button>
        <button id="participant-toggle" type="button" class="action rounded-xl border border-[#dbe4ec] bg-white p-4 flex flex-col items-center gap-2 text-[#14283f]">
          <i data-lucide="user-round-plus" class="w-6 h-6" aria-hidden="true"></i>
          <span class="font-bold text-[14px]">إضافة مشارك</span>
        </button>
      </div>
      <div id="keypad" hidden class="mt-6 pt-6 border-t border-[#e3e9ef] max-w-xs mx-auto">
        <div class="flex items-center justify-between gap-3 mb-3">
          <h3 class="font-bold text-[#14283f] text-[19px]">لوحة الأرقام</h3>
          <button id="keypad-close" type="button" class="rounded-lg px-3 py-1 border border-[#dbe4ec] text-[#14283f]">إغلاق</button>
        </div>
        <label for="digits" class="block mb-2 text-[#526579] text-[14px]">الأرقام المُدخلة</label>
        <input id="digits" type="text" inputmode="tel" autocomplete="off" maxlength="24" class="w-full rounded-xl border border-[#cbd7e2] px-4 py-2 text-center text-xl tracking-widest focus:border-[#1769a3]" dir="ltr">
        <div class="grid grid-cols-3 gap-2 mt-3" dir="ltr">
          <% ['1','2','3','4','5','6','7','8','9','*','0','#'].forEach(d => { %><button type="button" class="digit rounded-lg bg-[#edf3f8] py-2 font-bold" data-digit="<%= d %>"><%= d %></button>
          <% }) %>
        </div>
        <button id="digits-clear" type="button" class="mt-3 w-full rounded-lg border border-[#dbe4ec] py-2 text-[#1769a3] font-semibold">مسح الأرقام</button>
      </div>
      <div class="mt-6 pt-6 border-t border-[#e3e9ef] flex justify-center">
        <button id="end-open" type="button" class="action rounded-xl bg-[#b84a4a] text-white px-8 py-3 font-bold flex items-center gap-3">
          <i data-lucide="phone-off" class="w-5 h-5" aria-hidden="true"></i><span>إنهاء المكالمة</span>
        </button>
      </div>
    </section>
  </section>

  <section id="summary-view" hidden aria-labelledby="summary-title" class="reveal">
    <div class="surface rounded-[24px] border border-[#e3e9ef] p-7 sm:p-10 bg-white">
      <div class="w-14 h-14 rounded-xl bg-[#eaf1f7] text-[#1769a3] flex items-center justify-center mb-5"><i data-lucide="phone-off" aria-hidden="true"></i></div>
      <h2 id="summary-title" class="font-bold text-[#14283f] text-[24px]">انتهت المكالمة</h2>
      <div class="mt-6 border-y border-[#e3e9ef] py-5 space-y-3">
        <p><span class="font-bold text-[#526579]">الموظف:</span> <span class="text-[#14283f]"><%= caller.name %></span></p>
        <p><span class="font-bold text-[#526579]">مدة المكالمة:</span> <span id="summary-time" dir="ltr" class="inline-block tabular-nums font-bold">00:00</span></p>
      </div>
      <div class="flex flex-wrap gap-3 mt-7">
        <a id="back-directory" href="/directory" class="rounded-xl px-6 py-3 font-bold text-white" style="background: rgb(23,105,163);">العودة إلى دليل الموظفين</a>
        <a href="/calls" class="rounded-xl px-6 py-3 font-bold border border-[#dbe4ec] bg-white text-[#14283f]">المكالمات الأخيرة</a>
        <button id="restart" type="button" class="rounded-xl px-6 py-3 font-bold border border-[#dbe4ec] bg-white text-[#1769a3]">اتصال مرة أخرى</button>
      </div>
    </div>
  </section>

  <p class="mt-7 text-center text-[#64748b] text-[13px]">معاينة تفاعلية فقط؛ لا تُجرى مكالمة صوتية فعلية أو إضافة مشارك حقيقية.</p>
</div>

<div id="participant-modal" hidden class="overlay fixed inset-0 z-40 flex items-center justify-center p-4" aria-hidden="true">
  <div role="dialog" aria-modal="true" aria-labelledby="participant-title" class="w-full max-w-md max-h-[85vh] overflow-y-auto rounded-2xl bg-white p-6 shadow-2xl">
    <div class="flex items-start justify-between gap-3">
      <h2 id="participant-title" class="font-bold text-[#14283f] text-[24px]">إضافة مشارك</h2>
      <button id="participant-close" type="button" class="rounded-lg px-3 py-1 border border-[#dbe4ec] text-[#14283f]">إغلاق</button>
    </div>
    <p class="mt-2 mb-5 text-[#526579] text-[16px]">اختر أحد الحسابات المتاحة لك لعرض حالة الاختيار في المعاينة.</p>
    <div class="space-y-2">
      <% participants.forEach(p => { %>
        <button type="button" data-person="<%= p.name %>" class="person w-full text-right rounded-xl border border-[#dbe4ec] p-4 hover:bg-[#edf5fa] focus:bg-[#edf5fa]"><span class="font-bold text-[#14283f]"><%= p.name %> · <%= p.title %></span></button>
      <% }) %>
      <% if (participants.length === 0) { %><p class="text-[#526579]">لا توجد حسابات أخرى متاحة لك.</p><% } %>
    </div>
    <p id="participant-result" class="mt-4 text-[#1769a3] font-semibold" role="status"></p>
  </div>
</div>

<div id="end-modal" hidden class="overlay fixed inset-0 z-40 flex items-center justify-center p-4" aria-hidden="true">
  <div role="dialog" aria-modal="true" aria-labelledby="end-title" aria-describedby="end-description" class="w-full max-w-md rounded-2xl bg-white p-6 shadow-2xl">
    <h2 id="end-title" class="font-bold text-[#14283f] text-[24px]">تأكيد إنهاء المكالمة</h2>
    <p id="end-description" class="mt-3 text-[#526579] text-[16px]">هل تريد إنهاء معاينة المكالمة وعرض ملخصها؟</p>
    <div class="flex flex-wrap gap-3 mt-6">
      <button id="end-confirm" type="button" class="rounded-lg px-5 py-2 font-bold text-white" style="background: rgb(184,74,74);">تأكيد الإنهاء</button>
      <button id="end-cancel" type="button" class="rounded-lg border border-[#dbe4ec] px-5 py-2 font-bold bg-white text-[#14283f]">متابعة المكالمة</button>
    </div>
  </div>
</div>
<%- include('../partials/layout-end', { scripts: ['/js/call-active.js'] }) %>
