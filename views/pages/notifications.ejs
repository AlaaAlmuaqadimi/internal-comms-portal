<%- include('../partials/layout-start') %>
<div class="max-w-5xl mx-auto">
<div class="mb-8">
 <div class="flex items-center gap-3 mb-3"><span class="h-8 w-1 rounded-full bg-[#c4a56a]" aria-hidden="true"></span>
  <h1 class="font-extrabold leading-tight text-[#14283f] text-[32px]">الإشعارات</h1></div>
 <p class="leading-8 text-[#526579] text-[16px]">تابع التعميمات والإعلانات والمراسلات الإدارية في مكان واحد.</p>
</div>
<section aria-labelledby="list-heading">
            <div class="flex items-center justify-between gap-3 mb-4">
              <h2 id="list-heading" class="font-bold text-[#14283f] text-[24px]">آخر الإشعارات</h2>
              <span class="rounded-full px-3 py-1" style="background: rgb(246,240,228); color: rgb(120,94,48); font-weight:700; font-size:13px;">بيانات تجريبية</span>
            </div>
            <div class="space-y-4">
              <% notifications.forEach(notice => { %>
              <button type="button" class="notice <%= notice.unread ? 'unread' : '' %> block rounded-2xl p-5 sm:p-6 shadow-sm" data-index="<%= notice.id %>" aria-haspopup="dialog">
                <span class="flex items-start gap-4">
                  <span class="notice-icon" aria-hidden="true"><i data-lucide="<%= notice.icon %>"></i></span>
                  <span class="min-w-0 flex-1">
                    <span class="flex flex-wrap items-center justify-between gap-2">
                      <span class="font-bold text-[#1769a3] text-[16px]"><%= notice.type %></span>
                      <span class="font-bold text-sm">
                        <span class="unread-label text-[#1769a3] text-[16px]">● غير مقروء</span>
                        <span class="read-label text-[#64748b] text-[16px]">مقروء</span>
                      </span>
                    </span>
                    <span class="block font-bold mt-2 text-[#14283f] text-[19px]"><%= notice.title %></span>
                    <span class="block mt-1 leading-7 text-[#526579] text-[16px]"><%= notice.summary %></span>
                    <span class="block mt-3 text-sm">
                      <span class="text-[#64748b] text-[16px]"><%= notice.date %></span> <span aria-hidden="true">·</span> <span class="text-[#64748b] text-[16px]"><%= notice.time %></span>
                    </span>
                  </span>
                </span>
              </button>
              <% }) %>
            </div>
          </section>
          <footer class="pt-10 pb-3">
            <p class="text-center text-[#78889a] text-[13px]">واجهة إشعارات داخلية · محتوى تجريبي للمعاينة</p>
          </footer>
</div>
<div id="dialog-backdrop" class="dialog-backdrop fixed inset-0 z-50 hidden flex items-center justify-center p-4" hidden>
    <section id="notice-dialog" role="dialog" aria-modal="true" aria-labelledby="dialog-heading" tabindex="-1" class="w-full max-w-xl max-h-[85vh] overflow-y-auto rounded-2xl bg-white p-6 sm:p-8 shadow-2xl">
      <div class="flex items-start justify-between gap-4 border-b border-[#e3e9ef] pb-4">
        <h2 id="dialog-heading" class="font-bold text-[#14283f] text-[24px]">تفاصيل الإشعار</h2>
        <button id="dialog-close" type="button" class="rounded-lg px-3 py-1.5 font-bold hover:bg-[#eaf1f7]" style="background: rgb(237,245,250); color: rgb(23,105,163);">إغلاق</button>
      </div>
      <div class="pt-5">
        <% notifications.forEach(notice => { %>
        <article class="detail" data-detail="<%= notice.id %>" hidden>
          <p class="font-bold text-[#1769a3] text-[16px]"><%= notice.type %></p>
          <h3 class="font-bold mt-3 text-[#14283f] text-[19px]"><%= notice.title %></h3>
          <p class="mt-4 leading-8 text-[#526579] text-[16px]"><%= notice.body %></p>
          <p class="mt-5 text-[#64748b] text-[16px]"><%= notice.date %> · <%= notice.time %></p>
        </article>
        <% }) %>
      </div>
    </section>
  </div>

  <%- include('../partials/layout-end', { scripts: ['/js/notifications.js'] }) %>
