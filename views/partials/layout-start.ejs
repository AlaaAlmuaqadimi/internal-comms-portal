<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <%- include('./head', { title: title + ' | ' + agencyName }) %>
</head>
<body class="w-full" style="background: rgb(243, 246, 249);">
  <div class="shell w-full lg:grid lg:grid-cols-[244px_minmax(0,1fr)]">
    <%- include('./sidebar') %>
    <div class="min-w-0">
      <header class="border-b border-[#e3e9ef] bg-white px-5 sm:px-8 lg:px-10 py-4">
        <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-3">
          <div class="flex items-center gap-3">
            <span class="font-bold text-[#14283f] text-[16px]"><%= agencyName %></span>
            <span class="rounded-full px-4 py-1.5" style="background: rgb(246,240,228); color: rgb(120,94,48); font-weight:700; font-size:13px;">التواصل الإداري</span>
          </div>
          <div class="flex items-center gap-3">
            <%- include('./avatar', { person: currentUser, cls: 'w-9 h-9 rounded-full text-sm' }) %>
            <span class="font-bold text-[#14283f] text-[15px] hidden sm:inline"><%= currentUser.name %></span>
            <form method="post" action="/logout">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="rounded-lg px-3 py-1.5 border border-[#ccd9e5] hover:bg-[#eaf1f7] font-bold text-[#1769a3] text-[14px]">تسجيل الخروج</button>
            </form>
          </div>
        </div>
      </header>
      <main class="w-full px-5 sm:px-8 lg:px-10 py-8 lg:py-10">
        <div class="max-w-7xl mx-auto">
