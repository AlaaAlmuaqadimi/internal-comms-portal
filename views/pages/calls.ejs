<%- include('../partials/layout-start') %>
<section id="calls-view" class="enter" aria-labelledby="page-title">
  <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-7">
    <div class="border-r-4 border-[#c4a56a] pr-4">
      <p class="font-bold mb-1 text-[#1769a3] text-[14px]">سجل التواصل</p>
      <h1 id="page-title" class="font-extrabold leading-tight text-[#14283f] text-[32px]">المكالمات الأخيرة</h1>
      <p class="mt-1 text-[#526579] text-[16px]">متابعة منظمة لاتصالات الزملاء ضمن بيئة العمل الداخلية</p>
    </div>
    <div class="bg-white border border-[#e3e9ef] rounded-xl px-5 py-3 self-start sm:self-auto">
      <span class="text-[#526579] text-[14px]">عدد المكالمات المعروضة</span>
      <strong id="result-count" class="text-[#1769a3] tabular-nums text-xl mr-2" aria-live="polite"><%= calls.length %></strong>
    </div>
  </div>

  <section class="bg-white rounded-2xl border border-[#e3e9ef] card-shadow p-4 sm:p-5 mb-5" aria-label="البحث والتصفية">
    <div class="flex flex-col lg:flex-row gap-4 lg:items-end lg:justify-between">
      <div class="w-full lg:max-w-sm">
        <label for="call-search" class="block mb-2 font-bold text-[#14283f] text-[16px]">البحث في السجل</label>
        <div class="relative">
          <i data-lucide="search" class="absolute right-3 top-1/2 -translate-y-1/2 w-5 h-5 text-[#64748b] pointer-events-none" aria-hidden="true"></i>
          <input id="call-search" class="w-full rounded-xl border border-[#cbd7e2] bg-white py-2.5 pr-11 pl-4 focus:border-[#1769a3] text-[#14283f] text-[16px]" type="search" autocomplete="off" placeholder="ابحث في المكالمات الأخيرة">
        </div>
      </div>
      <div role="tablist" aria-label="نوع المكالمة" class="flex flex-wrap gap-2">
        <button type="button" class="filter rounded-lg border border-[#dbe4ec] px-4 py-2 font-bold" role="tab" aria-selected="true" data-filter="all">الكل</button>
        <button type="button" class="filter rounded-lg border border-[#dbe4ec] px-4 py-2 font-bold" role="tab" aria-selected="false" data-filter="incoming">الواردة</button>
        <button type="button" class="filter rounded-lg border border-[#dbe4ec] px-4 py-2 font-bold" role="tab" aria-selected="false" data-filter="outgoing">الصادرة</button>
        <button type="button" class="filter rounded-lg border border-[#dbe4ec] px-4 py-2 font-bold" role="tab" aria-selected="false" data-filter="missed">الفائتة</button>
      </div>
    </div>
  </section>

  <div id="call-list" class="space-y-3" aria-label="سجل المكالمات">
    <% calls.forEach(call => {
      const c = call.contact;
      const color = call.type === 'incoming' ? '#1769a3' : call.type === 'outgoing' ? '#236b56' : '#a44830';
    %>
    <article data-type="<%= call.type %>" data-search="<%= [c.name, c.unitName, c.management].join(' ') %>" class="call-row bg-white border border-[#e3e9ef] <%= call.type === 'missed' ? 'border-r-4 border-r-[#b65b41]' : '' %> rounded-2xl p-4 sm:p-5">
      <div class="flex flex-col md:flex-row md:items-center gap-4">
        <div class="flex items-start sm:items-center gap-4 min-w-0 flex-1">
          <%- include('../partials/avatar', { person: c, cls: 'w-14 h-14 sm:w-16 sm:h-16 rounded-xl' }) %>
          <div class="min-w-0">
            <h2 class="font-bold text-[#14283f] text-[18px]"><%= c.name %></h2>
            <p class="text-[#526579] text-[14px]"><%= c.unitName %></p>
          </div>
        </div>
        <div class="md:w-56">
          <p class="inline-flex items-center gap-2 font-bold" style="color: <%= color %>;"><i data-lucide="<%= call.icon %>" class="w-4 h-4" aria-hidden="true"></i><span class="text-[14px]"><%= call.typeLabel %></span></p>
          <p class="mt-1 text-[#526579] text-[13px]"><%= call.date %> · <%= call.time %></p>
          <p class="text-[#526579] text-[13px]"><%= call.duration %></p>
        </div>
        <button type="button" class="call-button rounded-xl bg-[#1769a3] text-white px-5 py-2.5 font-bold inline-flex items-center justify-center gap-2 self-start md:self-center" data-contact="<%= c.id %>" data-person="<%= c.name %>" aria-label="اتصال بـ<%= c.name %>">
          <i data-lucide="phone" class="w-4 h-4" aria-hidden="true"></i><span>اتصال</span>
        </button>
      </div>
    </article>
    <% }) %>
  </div>

  <div id="empty-state" hidden class="bg-white border border-[#e3e9ef] rounded-2xl text-center px-6 py-12">
    <i data-lucide="search-x" class="w-10 h-10 text-[#64748b] mx-auto mb-3" aria-hidden="true"></i>
    <h2 class="font-bold text-[#14283f] text-[20px]">لا توجد مكالمات مطابقة</h2>
    <p class="mt-1 mb-5 text-[#526579] text-[16px]"><%= calls.length ? 'جرّب كلمة بحث أخرى أو غيّر نوع المكالمة.' : 'لا توجد مكالمات مسجّلة مع الحسابات المتاحة لك. ابدأ من دليل الموظفين.' %></p>
    <% if (calls.length) { %><button id="reset-filters" type="button" class="rounded-xl px-5 py-2.5 font-bold text-white" style="background: rgb(23,105,163);">إعادة ضبط التصفية</button>
    <% } else { %><a href="/directory" class="inline-block rounded-xl px-5 py-2.5 font-bold text-white" style="background: rgb(23,105,163);">فتح دليل الموظفين</a><% } %>
  </div>
</section>

<div id="call-modal" hidden class="modal-backdrop fixed inset-0 z-40 flex items-center justify-center p-4">
  <div role="dialog" aria-modal="true" aria-labelledby="modal-heading" aria-describedby="modal-description" class="w-full max-w-md rounded-2xl bg-white p-6 sm:p-8 shadow-2xl">
    <div class="w-12 h-12 rounded-xl bg-[#eaf1f7] text-[#1769a3] flex items-center justify-center mb-4"><i data-lucide="phone" aria-hidden="true"></i></div>
    <h2 id="modal-heading" class="font-bold text-[#14283f] text-[24px]">تأكيد الاتصال</h2>
    <p id="modal-description" class="mt-2 text-[#526579] text-[16px]">هل تريد بدء معاينة مكالمة مع الموظف التالي؟ لا تُجرى مكالمة حقيقية.</p>
    <p id="selected-person" class="font-bold text-[#14283f] mt-4" aria-live="polite"></p>
    <div class="flex flex-wrap gap-3 mt-6">
      <button id="start-call" type="button" class="rounded-xl px-5 py-2.5 font-bold text-white" style="background: rgb(23,105,163);">بدء مكالمة</button>
      <button id="cancel-call" type="button" class="rounded-xl border border-[#dbe4ec] px-5 py-2.5 font-bold bg-white text-[#14283f]">إلغاء</button>
    </div>
  </div>
</div>
<%- include('../partials/layout-end', { scripts: ['/js/calls.js'] }) %>
