<%- include('../partials/auth-start') %>
<div class="max-w-md mx-auto">
  <div class="mb-6 border-r-4 border-[#c4a56a] pr-4">
    <h1 class="font-extrabold leading-tight text-[#14283f] text-[28px]">تسجيل الدخول</h1>
    <p class="mt-1 text-[#526579] text-[16px]">أدخل بيانات حسابك للوصول إلى بوابة التواصل.</p>
  </div>
  <form method="post" action="/login" class="rounded-2xl border border-[#e3e9ef] bg-white card-shadow p-6 sm:p-8 space-y-5" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="next" value="<%= next %>">
    <%- include('../partials/form-errors') %>
    <div>
      <label for="username" class="block font-bold mb-2 text-[#14283f]">اسم المستخدم</label>
      <input id="username" name="username" class="field" dir="ltr" autocomplete="username" required maxlength="30" value="<%= values.username || '' %>" autofocus>
    </div>
    <div>
      <label for="password" class="block font-bold mb-2 text-[#14283f]">كلمة المرور</label>
      <input id="password" name="password" type="password" class="field" dir="ltr" autocomplete="current-password" required>
    </div>
    <button type="submit" class="w-full rounded-xl py-3 font-bold text-white" style="background: rgb(23,105,163);">دخول</button>
  </form>
  <p class="mt-5 text-center text-[#526579]">ليس لديك حساب؟ <a href="/register" class="font-bold text-[#1769a3] underline">إنشاء حساب جديد</a></p>
</div>
<%- include('../partials/auth-end') %>
