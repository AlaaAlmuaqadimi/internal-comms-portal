<%- include('../partials/layout-start') %>
<div class="mb-8 border-r-4 border-[#c4a56a] pr-4">
  <h1 class="font-extrabold leading-tight text-[#14283f] text-[32px]">مرحبًا، <%= currentUser.name %></h1>
  <p class="mt-1 text-[#526579] text-[16px]">نظرة سريعة على جهات الاتصال المتاحة لك وآخر المستجدات.</p>
</div>

<section class="grid sm:grid-cols-2 xl:grid-cols-4 gap-4 mb-8" aria-label="ملخص">
  <% [
    { href: '/directory', label: 'جهات الاتصال المتاحة', value: stats.contacts, icon: 'users-round' },
    { href: '/directory', label: 'المتصلون الآن', value: stats.online, icon: 'circle-check' },
    { href: '/calls', label: 'مكالمات فائتة', value: stats.missed, icon: 'phone-missed' },
    { href: '/notifications', label: 'إشعارات غير مقروءة', value: stats.unread, icon: 'bell' }
  ].forEach(card => { %>
    <a href="<%= card.href %>" class="block rounded-2xl border border-[#e3e9ef] bg-white card-shadow p-5 hover:-translate-y-0.5 transition-transform">
      <span class="flex items-center justify-between text-[#526579] text-[14px]"><%= card.label %><i data-lucide="<%= card.icon %>" class="w-5 h-5 text-[#1769a3]" aria-hidden="true"></i></span>
      <span class="block mt-2 font-extrabold tabular-nums text-[#1769a3] text-[32px]"><%= card.value %></span>
    </a>
  <% }) %>
</section>

<section aria-labelledby="online-heading">
  <div class="flex items-center justify-between gap-3 mb-4">
    <h2 id="online-heading" class="font-bold text-[#14283f] text-[24px]">متصلون الآن</h2>
    <a href="/directory" class="font-bold text-[#1769a3] underline">عرض الدليل كاملًا</a>
  </div>
  <% if (onlineContacts.length === 0) { %>
    <div class="rounded-2xl border border-dashed border-[#cbd7e2] bg-white p-8 text-center text-[#526579]">لا يوجد أحد من جهات الاتصال المتاحة متصلًا حاليًا.</div>
  <% } else { %>
    <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-4">
      <% onlineContacts.forEach(c => { %>
        <article class="rounded-2xl border border-[#e3e9ef] bg-white p-4 flex items-center gap-4">
          <%- include('../partials/avatar', { person: c, cls: 'w-14 h-14 rounded-xl' }) %>
          <div class="min-w-0 flex-1">
            <h3 class="font-bold text-[#14283f] text-[16px]"><%= c.name %></h3>
            <p class="text-[#526579] text-[13px]"><%= c.title %> · <%= c.unitName %></p>
          </div>
          <a href="/call/active?contact=<%= c.id %>" class="rounded-lg px-4 py-2 font-bold text-white text-[14px]" style="background: rgb(23,105,163);" aria-label="اتصال بـ<%= c.name %>">اتصال</a>
        </article>
      <% }) %>
    </div>
  <% } %>
</section>
<%- include('../partials/layout-end') %>
