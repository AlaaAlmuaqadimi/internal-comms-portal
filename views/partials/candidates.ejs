<% if (kitchens && kitchens.length) { %>
  <div class="rounded-xl border border-[#e9dcc2] bg-[#fbf6ec] p-4 mb-5">
    <h3 class="font-bold text-[#7a5a1e] text-[15px] mb-2 flex items-center gap-2"><i data-lucide="chef-hat" class="w-4 h-4" aria-hidden="true"></i>سترتبط تلقائيًا بهذه المطابخ حسب موقعك</h3>
    <ul class="space-y-1">
      <% kitchens.forEach(k => { %><li class="text-[#5b4515] text-[14px]"><span class="font-bold"><%= k.name %></span> — <%= k.path %></li><% }) %>
    </ul>
    <p class="mt-2 text-[#8a7a54] text-[12px]">لا يمكن اختيار المطابخ يدويًا؛ هي جزء ثابت من الهيكل الإداري.</p>
  </div>
<% } %>
<% if (!groups) { %>
  <p class="rounded-xl border border-dashed border-[#cbd7e2] p-5 text-center text-[#526579]">اختر موقعك في الهيكل الإداري لتظهر الحسابات المتاحة لك.</p>
<% } else if (groups.length === 0) { %>
  <p class="rounded-xl border border-dashed border-[#cbd7e2] p-5 text-center text-[#526579]">لا توجد حاليًا حسابات مرتبطة بهذا الموقع (المرتبة الأعلى بدرجة واحدة، أو نفس المستوى، أو من يندرج أسفله). تظهر الحسابات الجديدة هنا تلقائيًا، ويمكنك اختيارها لاحقًا من «الإعدادات».</p>
<% } else { %>
  <% groups.forEach(g => { %>
    <section class="mb-5" aria-label="<%= g.label %>">
      <h3 class="font-bold text-[#243b53] text-[15px] mb-2"><%= g.label %> <span class="font-normal text-[#64748b]">(<%= g.items.length %>)</span></h3>
      <div class="grid sm:grid-cols-2 gap-3">
        <% g.items.forEach(p => { %>
          <label class="contact-option flex items-center gap-3 rounded-xl border border-[#e3e9ef] p-3 cursor-pointer hover:bg-[#f5f9fc]" data-search="<%= [p.name, p.title, p.unitName, p.management].join(' ') %>">
            <input type="checkbox" name="contacts" value="<%= p.id %>" class="w-5 h-5 shrink-0 accent-[#1769a3]" <%= selected.includes(p.id) ? 'checked' : '' %>>
            <%- include('./avatar', { person: p, cls: 'w-12 h-12 rounded-lg' }) %>
            <span class="min-w-0">
              <span class="block font-bold text-[#14283f] text-[15px]"><%= p.name %></span>
              <span class="block text-[#526579] text-[13px]"><%= p.title %> · <%= p.unitName %></span>
            </span>
          </label>
        <% }) %>
      </div>
    </section>
  <% }) %>
<% } %>
