        </div>
      </main>
    </div>
  </div>
  <%- include('./toast') %>
  <% if (flash) { %><div id="flash" data-message="<%= flash %>" hidden></div><% } %>
  <script src="/js/common.js"></script>
  <% (typeof scripts !== 'undefined' ? scripts : []).forEach(src => { %><script src="<%= src %>"></script>
  <% }) %>
</body>
</html>
