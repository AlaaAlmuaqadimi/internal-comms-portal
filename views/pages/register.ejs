<%- include('../partials/auth-start') %>
<div class="mb-6 border-r-4 border-[#c4a56a] pr-4">
  <h1 class="font-extrabold leading-tight text-[#14283f] text-[28px]">إنشاء حساب</h1>
  <p class="mt-1 text-[#526579] text-[16px]">أدخل بياناتك، ثم اختر الحسابات التي يمكنك التواصل معها. لن ترى أو تتصل بغيرها.</p>
</div>
<form method="post" action="/register" class="rounded-2xl border border-[#e3e9ef] bg-white card-shadow p-6 sm:p-8 space-y-6" novalidate>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <%- include('../partials/form-errors') %>

  <fieldset class="grid sm:grid-cols-2 gap-4">
    <legend class="font-bold text-[#14283f] text-[18px] mb-3">بيانات الحساب</legend>
    <div class="sm:col-span-2">
      <label for="name" class="block font-bold mb-2 text-[#14283f]">الاسم الكامل</label>
      <input id="name" name="name" class="field" required maxlength="60" autocomplete="name" value="<%= values.name || '' %>">
    </div>
    <div>
      <label for="username" class="block font-bold mb-2 text-[#14283f]">اسم المستخدم</label>
      <input id="username" name="username" class="field" dir="ltr" required maxlength="30" autocomplete="username" value="<%= values.username || '' %>" aria-describedby="username-hint">
      <p id="username-hint" class="mt-1 text-[#64748b] text-[13px]">أحرف إنجليزية وأرقام فقط (3–30).</p>
    </div>
    <div>
      <label for="title" class="block font-bold mb-2 text-[#14283f]">المسمى الوظيفي</label>
      <input id="title" name="title" class="field" required maxlength="60" value="<%= values.title || '' %>">
    </div>
    <div>
      <label for="password" class="block font-bold mb-2 text-[#14283f]">كلمة المرور</label>
      <input id="password" name="password" type="password" class="field" dir="ltr" required minlength="8" maxlength="72" autocomplete="new-password">
      <p class="mt-1 text-[#64748b] text-[13px]">8 أحرف على الأقل.</p>
    </div>
    <div>
      <label for="confirm" class="block font-bold mb-2 text-[#14283f]">تأكيد كلمة المرور</label>
      <input id="confirm" name="confirm" type="password" class="field" dir="ltr" required autocomplete="new-password">
    </div>
    <div>
      <label for="department" class="block font-bold mb-2 text-[#14283f]">الإدارة</label>
      <select id="department" name="department" class="field" required>
        <option value="">اختر الإدارة</option>
        <% departments.forEach(d => { %><option <%= values.department === d ? 'selected' : '' %>><%= d %></option><% }) %>
      </select>
    </div>
    <div>
      <label for="region" class="block font-bold mb-2 text-[#14283f]">المنطقة</label>
      <select id="region" name="region" class="field" required>
        <option value="">اختر المنطقة</option>
        <% regions.forEach(r => { %><option <%= values.region === r ? 'selected' : '' %>><%= r %></option><% }) %>
      </select>
    </div>
    <div>
      <label for="section" class="block font-bold mb-2 text-[#14283f]">القسم <span class="font-normal text-[#64748b] text-[13px]">(اختياري)</span></label>
      <input id="section" name="section" class="field" maxlength="60" value="<%= values.section || '' %>">
    </div>
    <div>
      <label for="office" class="block font-bold mb-2 text-[#14283f]">المكتب <span class="font-normal text-[#64748b] text-[13px]">(اختياري)</span></label>
      <input id="office" name="office" class="field" maxlength="60" value="<%= values.office || '' %>">
    </div>
  </fieldset>

  <fieldset>
    <legend class="font-bold text-[#14283f] text-[18px]">الحسابات التي يمكنني التواصل معها</legend>
    <p class="mt-1 mb-4 text-[#526579] text-[14px]">اختر واحدًا أو أكثر. سيظهر لك في الدليل وسجل المكالمات هذه الحسابات فقط، ولن يمكنك الاتصال بغيرها.</p>
    <div class="flex flex-wrap items-center gap-3 mb-4">
      <div class="relative flex-1 min-w-[200px]">
        <i data-lucide="search" class="absolute right-3 top-1/2 -translate-y-1/2 w-5 h-5 text-[#64748b] pointer-events-none" aria-hidden="true"></i>
        <input id="contact-search" type="search" class="field !pr-11" placeholder="ابحث في الحسابات" autocomplete="off" aria-label="ابحث في الحسابات">
      </div>
      <button type="button" id="select-all" class="rounded-lg px-3 py-2 border border-[#ccd9e5] font-bold text-[#1769a3] text-[14px]">تحديد الكل</button>
      <button type="button" id="select-none" class="rounded-lg px-3 py-2 border border-[#ccd9e5] font-bold text-[#1769a3] text-[14px]">إلغاء التحديد</button>
    </div>
    <div class="grid sm:grid-cols-2 gap-3" id="contact-list">
      <% profiles.forEach(p => { %>
        <label class="contact-option flex items-center gap-3 rounded-xl border border-[#e3e9ef] p-3 cursor-pointer hover:bg-[#f5f9fc]" data-search="<%= [p.name, p.title, p.department].join(' ') %>">
          <input type="checkbox" name="contacts" value="<%= p.id %>" class="w-5 h-5 shrink-0 accent-[#1769a3]" <%= (values.contacts || []).includes(p.id) ? 'checked' : '' %>>
          <%- include('../partials/avatar', { person: p, cls: 'w-12 h-12 rounded-lg' }) %>
          <span class="min-w-0">
            <span class="block font-bold text-[#14283f] text-[15px]"><%= p.name %></span>
            <span class="block text-[#526579] text-[13px]"><%= p.title %> · <%= p.department %></span>
          </span>
        </label>
      <% }) %>
    </div>
    <p class="mt-3 text-[#1769a3] font-bold" role="status" aria-live="polite">المحدد: <span id="selected-count">0</span></p>
  </fieldset>

  <button type="submit" class="w-full rounded-xl py-3 font-bold text-white" style="background: rgb(23,105,163);">إنشاء الحساب</button>
</form>
<p class="mt-5 text-center text-[#526579]">لديك حساب؟ <a href="/login" class="font-bold text-[#1769a3] underline">تسجيل الدخول</a></p>
<%- include('../partials/auth-end', { scripts: ['/js/register.js'] }) %>
