<% /* locals: kitchenOptions ({type:'none'}|{type:'fixed',kitchen}|{type:'choice',options}), kitchenChoice (currently saved id, may be null), formId (optional, only used on settings' standalone form) */ %>
<% if (kitchenOptions.type === 'fixed') { %>
  <div class="rounded-xl border border-[#e9dcc2] bg-[#fbf6ec] p-4 mb-5">
    <h3 class="font-bold text-[#7a5a1e] text-[15px] mb-1 flex items-center gap-2"><i data-lucide="chef-hat" class="w-4 h-4" aria-hidden="true"></i>المطبخ المرتبط بموقعك</h3>
    <p class="text-[#5b4515] text-[14px]"><span class="font-bold"><%= kitchenOptions.kitchen.name %></span> — <%= kitchenOptions.kitchen.path %></p>
    <p class="mt-1 text-[#8a7a54] text-[12px]">مطبخ واحد فقط يخدم هذا الموقع، فلا حاجة للاختيار.</p>
  </div>
<% } else if (kitchenOptions.type === 'choice') { %>
  <fieldset class="rounded-xl border border-[#e9dcc2] bg-[#fbf6ec] p-4 mb-5">
    <legend class="font-bold text-[#7a5a1e] text-[15px] mb-2 flex items-center gap-2 px-1"><i data-lucide="chef-hat" class="w-4 h-4" aria-hidden="true"></i>اختر المطبخ الذي يخدمك</legend>
    <div class="flex flex-col sm:flex-row gap-3">
      <% kitchenOptions.options.forEach((k, i) => { %>
        <label class="flex items-center gap-2 rounded-xl border border-[#e9dcc2] bg-white px-4 py-2.5 cursor-pointer flex-1">
          <input type="radio" name="kitchenChoice" value="<%= k.id %>" class="accent-[#8a6a2f]" required <%= kitchenChoice === k.id ? 'checked' : '' %>>
          <span class="font-bold text-[#5b4515] text-[15px]"><%= k.name %></span>
        </label>
      <% }) %>
    </div>
    <p class="mt-2 text-[#8a7a54] text-[12px]">موقعك يقع ضمن نطاق مطبخين مشتركين؛ اختر أحدهما.</p>
  </fieldset>
<% } %>
